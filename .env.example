# Copy to .env and `chmod 600 .env`. Everything here is optional.
RECONFORGE_HOST=127.0.0.1
RECONFORGE_PORT=8000
RECONFORGE_DATA_DIR=./data
# Extra directories (colon separated) ffuf wordlists may be read from
# RECONFORGE_WORDLIST_DIRS=/usr/share/wordlists:/usr/share/seclists
# Extra Host header names accepted by the dashboard (DNS-rebinding protection)
# RECONFORGE_ALLOWED_HOSTS=
# Pin a tool binary (useful when `httpx` resolves to the Python CLI)
# RECONFORGE_TOOL_HTTPX=/usr/bin/httpx-toolkit
# Provider keys can also live in data/secrets.json (written by the Settings page, mode 0600)
# RECONFORGE_SHODAN_API_KEY=
# RECONFORGE_URLSCAN_API_KEY=
